generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  OPERADOR
  CAJERO
  LECTOR
  CONSULTA
}

enum DocumentType {
  CC
  NIT
  CE
  TI
  PASAPORTE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum AuditEntity {
  USER
  CUSTOMER
  PROPERTY
  METER
  BILLING_PERIOD
  METER_READING
  TARIFF
  INVOICE
  PAYMENT
}

enum BillingPeriodStatus {
  DRAFT
  OPEN
  CLOSED
}

enum TariffStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum InvoiceItemType {
  FIXED_CHARGE
  CONSUMPTION
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  recordedPayments Payment[] @relation("PaymentRecordedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Customer {
  id             String       @id @default(uuid())
  documentType   DocumentType @map("document_type")
  documentNumber String       @unique @map("document_number")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String?
  phone          String?
  address        String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  properties Property[]
  invoices   Invoice[]

  @@map("customers")
}

model Property {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  code         String   @unique
  address      String
  municipality String
  vereda       String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])
  meters   Meter[]

  @@index([customerId])
  @@map("properties")
}

model Meter {
  id               String    @id @default(uuid())
  propertyId       String    @map("property_id")
  serialNumber     String    @unique @map("serial_number")
  brand            String?
  installationDate DateTime? @map("installation_date")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id])
  readings MeterReading[]
  invoices Invoice[]

  @@index([propertyId])
  @@map("meters")
}

model BillingPeriod {
  id        String              @id @default(uuid())
  year      Int
  month     Int
  status    BillingPeriodStatus @default(DRAFT)
  openedAt  DateTime?           @map("opened_at")
  closedAt  DateTime?           @map("closed_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  readings  MeterReading[]
  invoices  Invoice[]

  @@unique([year, month])
  @@index([status])
  @@map("billing_periods")
}

model MeterReading {
  id              String   @id @default(uuid())
  meterId         String   @map("meter_id")
  billingPeriodId String   @map("billing_period_id")
  readingValue    Decimal  @db.Decimal(12, 3) @map("reading_value")
  previousValue   Decimal  @db.Decimal(12, 3) @map("previous_value")
  consumption     Decimal  @db.Decimal(12, 3)
  readingDate     DateTime @map("reading_date")
  hasAnomaly      Boolean  @default(false) @map("has_anomaly")
  anomalyReason   String?  @map("anomaly_reason")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  meter        Meter         @relation(fields: [meterId], references: [id])
  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id])
  invoice       Invoice?

  @@unique([meterId, billingPeriodId])
  @@index([billingPeriodId])
  @@index([meterId, readingDate])
  @@index([hasAnomaly])
  @@map("meter_readings")
}

model Tariff {
  id                 String       @id @default(uuid())
  name               String
  fixedCharge        Decimal      @db.Decimal(14, 2) @map("fixed_charge")
  pricePerCubicMeter Decimal      @db.Decimal(14, 2) @map("price_per_cubic_meter")
  validFrom          DateTime     @db.Date @map("valid_from")
  validTo            DateTime?    @db.Date @map("valid_to")
  status             TariffStatus @default(DRAFT)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  invoices           Invoice[]

  @@index([status])
  @@index([validFrom, validTo])
  @@map("tariffs")
}

model Invoice {
  id                 String        @id @default(uuid())
  sequence           Int           @unique @default(autoincrement())
  billingPeriodId    String        @map("billing_period_id")
  meterReadingId     String        @unique @map("meter_reading_id")
  meterId            String        @map("meter_id")
  customerId         String        @map("customer_id")
  tariffId           String        @map("tariff_id")
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime      @db.Date @map("issue_date")
  dueDate            DateTime      @db.Date @map("due_date")
  customerName       String        @map("customer_name")
  customerDocument   String        @map("customer_document")
  propertyCode       String        @map("property_code")
  propertyAddress    String        @map("property_address")
  meterSerial        String        @map("meter_serial")
  previousReading    Decimal       @db.Decimal(12, 3) @map("previous_reading")
  currentReading     Decimal       @db.Decimal(12, 3) @map("current_reading")
  consumption        Decimal       @db.Decimal(12, 3)
  subtotal           Decimal       @db.Decimal(14, 2)
  total              Decimal       @db.Decimal(14, 2)
  issuedAt           DateTime?     @map("issued_at")
  voidedAt           DateTime?     @map("voided_at")
  voidReason         String?       @map("void_reason")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id])
  meterReading  MeterReading  @relation(fields: [meterReadingId], references: [id])
  meter         Meter         @relation(fields: [meterId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  tariff        Tariff        @relation(fields: [tariffId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([meterId, billingPeriodId])
  @@index([billingPeriodId, status])
  @@index([customerId])
  @@map("invoices")
}

model Payment {
  id           String        @id @default(uuid())
  invoiceId    String        @map("invoice_id")
  amount       Decimal       @db.Decimal(14, 2)
  paymentDate  DateTime      @db.Date @map("payment_date")
  method       PaymentMethod
  reference    String?       @unique
  notes        String?
  recordedById String        @map("recorded_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User    @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([invoiceId, paymentDate])
  @@index([paymentDate])
  @@map("payments")
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String          @map("invoice_id")
  type        InvoiceItemType
  description String
  quantity    Decimal         @db.Decimal(12, 3)
  unitPrice   Decimal         @db.Decimal(14, 2) @map("unit_price")
  amount      Decimal         @db.Decimal(14, 2)
  createdAt   DateTime        @default(now()) @map("created_at")
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  action    AuditAction
  entity    AuditEntity
  entityId  String      @map("entity_id")
  changes   Json?
  ipAddress String?     @map("ip_address")
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
