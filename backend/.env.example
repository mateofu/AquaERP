# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
DATABASE_URL=postgresql://aquaerp:replace-with-a-strong-password@localhost:5432/aquaerp?schema=public

# PostgreSQL (docker-compose)
POSTGRES_USER=aquaerp
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=aquaerp
POSTGRES_PORT=5432

# JWT
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed (opcional)
SEED_ADMIN_EMAIL=replace-with-admin-email@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# CORS
CORS_ORIGIN=http://localhost:4200

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
