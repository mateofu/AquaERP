# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database
DATABASE_URL=postgresql://aquaerp:aquaerp@localhost:5432/aquaerp?schema=public

# PostgreSQL (docker-compose)
POSTGRES_USER=aquaerp
POSTGRES_PASSWORD=aquaerp
POSTGRES_DB=aquaerp
POSTGRES_PORT=5432

# JWT
JWT_ACCESS_SECRET=change-me-use-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed (opcional)
SEED_ADMIN_EMAIL=admin@aquaerp.local
SEED_ADMIN_PASSWORD=Admin123!

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# CORS
CORS_ORIGIN=http://localhost:4200
